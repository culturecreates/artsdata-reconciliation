@prefix adr:<http://kg.artsdata.ca/resource/>.
@prefix schema:<http://schema.org/>.
@prefix ext:<http://external-source.com/resource/>.
@prefix xsd:<http://www.w3.org/2001/XMLSchema#>.

adr:Place1 a schema:Place ;
