@prefix adr:    <http://kg.artsdata.ca/resource/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .

# Places
adr:KP-1 a schema:Place ;
    rdfs:label "Place Bell" ;
    schema:name "Place Bell" ;
    schema:url "http://www.placebell.ca";
    schema:address adr:KP-1-address.

#address
adr:KP-1-address a schema:PostalAddress ;
    schema:postalCode "123 123" ;
    schema:streetAddress "street 123" ;
    schema:addressLocality "Toronto";
    schema:addressRegion "ON";
    schema:addressCountry "CA".

#Events
adr:KP-1-event a schema:Event ;
    schema:name "Event Bell" ;
    rdfs:label "Place Bell" ;
    schema:startDate "2018-01-01" ;
    schema:endDate "2018-01-02" ;
    schema:location adr:KP-1;
    schema:performer adr:KP-1-performer;
    schema:organizer adr:KP-1-organizer.

#Person
adr:KP-1-performer a schema:Person ;
    schema:name "Performer Bell";
    rdfs:label "Performer Bell" .

#Organization
adr:KP-1-organizer a schema:Organization ;
    schema:name "Organizer Bell";
    rdfs:label "Organizer Bell" .

#Event used for the language, missing label and offer cases
adr:KP-2-event a schema:Event ;
    schema:name "Event Two" ;
    schema:startDate "2019-05-05" ;
    schema:location adr:KP-2 ;
    schema:performer adr:KP-2-performer ;
    schema:organizer adr:KP-2-organizer ;
    schema:offers adr:KP-2-offer .

adr:KP-2 a schema:Place ;
    rdfs:label "Place Two" ;
    schema:name "Place Two" ;
    schema:address adr:KP-2-address.

adr:KP-2-address a schema:PostalAddress ;
    schema:postalCode "456 456" ;
    schema:streetAddress "street 456" ;
    schema:addressLocality "Montreal";
    schema:addressRegion "QC";
    schema:addressCountry "CA".

# Performer with a name in more than one language
adr:KP-2-performer a schema:Person ;
    schema:name "Performer Two"@en, "Interprete Deux"@fr .

# Organizer without a schema:name
adr:KP-2-organizer a schema:Organization ;
    rdfs:label "Organizer Two" .

adr:KP-2-offer a schema:Offer ;
    schema:url "http://tickets.example.com/kp-2" .
