@prefix schema:<http://schema.org/>.
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#>.
@prefix dbo:<http://dbpedia.org/ontology/>.
@prefix ado:    <http://kg.artsdata.ca/ontology/> .

schema:Organization rdfs:subClassOf dbo:Agent.
ado:Organization rdfs:subClassOf dbo:Agent.

schema:Person rdfs:subClassOf dbo:Agent.
ado:Person rdfs:subClassOf dbo:Agent.
